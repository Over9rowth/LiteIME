#include <winver.h>

// Primary TSF language profile icon (index 0, referenced by RegisterProfile(..., uIconIndex = 0))
101 ICON "../../assets/liteime.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Over9rowth"
            VALUE "FileDescription", "LiteIME Windows TSF Text Service"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "LiteIME64.dll"
            VALUE "OriginalFilename", "LiteIME64.dll"
            VALUE "ProductName", "LiteIME"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
